# Keep this repository limited to files stored at its top level.
/*/

# Repository automation is version-controlled despite the top-level directory rule.
!/.github/
!/.github/**
!/fdm_licensing/
!/fdm_licensing/**
!/tests/
!/tests/**

# Python-generated files (also covered by the directory rule above).
__pycache__/
*.py[cod]
*.pyd
*.egg-info/

# Generated packaging output.
build/
dist/

# Virtual environments.
.venv/
venv/
env/

# Local configuration and credentials.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.log

# Operating-system files.
.DS_Store
Thumbs.db
