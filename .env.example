# Copy the values you need into your shell or PyCharm run configuration.
# Do not put real credentials in this example file.

FDM_HOST=ftd01.example.com
FDM_PORT=443
FDM_USERNAME=admin
FDM_PASSWORD=
FDM_CA_BUNDLE=
FDM_CERTIFICATE_STORE_DIR=certificates
FDM_API_VERSION=latest
FDM_VERIFY_CERTIFICATE=true
FDM_DEBUG_LOGGING=false
FDM_LOG_FILE=

# Used by the README's Cisco Support API example. The current example.py
# script does not read these variables.
CISCO_CLIENT_ID=
CISCO_CLIENT_SECRET=
